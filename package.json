{
  "name": "apps-in-toss-harness",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint && pnpm lint:shared && pnpm lint:launcher",
    "lint:shared": "cd shared/internal-protocol && biome check .",
    "lint:launcher": "cd sites/launcher && biome check .",
    "test": "pnpm -r test && pnpm test:scripts && pnpm test:shared && pnpm test:launcher",
    "test:scripts": "node --test \"scripts/__tests__/**/*.test.mjs\"",
    "test:shared": "vitest run --root shared/internal-protocol",
    "test:launcher": "pnpm --filter @apps-in-toss/devtools exec vitest run --config e2e/launcher-site.vitest.config.ts",
    "build": "pnpm -r --if-present build",
    "check:pack-manifests": "node scripts/check-pack-manifests.mjs",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:shared && pnpm typecheck:launcher",
    "typecheck:shared": "tsc --noEmit -p shared/internal-protocol/tsconfig.json",
    "typecheck:launcher": "tsc --noEmit -p sites/launcher/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
