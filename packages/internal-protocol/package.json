{
  "name": "@apps-in-toss/internal-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Shared device<->host wire-protocol source for @ait-co/debugger and @ait-co/debug-console — workspace-internal only, never published; consumed as raw TypeScript by sibling packages' bundlers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./relay-auth-close": "./src/relay-auth-close.ts",
    "./debug-host": "./src/debug-host.ts",
    "./bridge-observer-state": "./src/bridge-observer-state.ts",
    "./attach-handshake": "./src/attach-handshake.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "BSD-3-Clause"
}
