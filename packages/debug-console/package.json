{
  "name": "@apps-in-toss/debug-console",
  "version": "0.1.7",
  "description": "On-device attach + status banner for Apps in Toss mini-apps — the only package in this split that can enter a production bundle",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "release:version": "node ../../scripts/changeset-version.mjs debug-console",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "3.8.0",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "mini-app",
    "debug-console",
    "on-device",
    "status-banner"
  ],
  "packageManager": "pnpm@12.10.1",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toss/apps-in-toss-harness",
    "directory": "packages/debug-console"
  },
  "bugs": {
    "url": "https://github.com/toss/apps-in-toss-harness/issues"
  },
  "homepage": "https://github.com/toss/apps-in-toss-harness"
}
