{
  "name": "@apps-in-toss/debug-console",
  "version": "0.1.3",
  "description": "On-device attach + eruda console for Apps in Toss mini-apps — the only package in this split that can enter a production bundle",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "eruda": "^3.4.3"
  },
  "devDependencies": {
    "@apps-in-toss/internal-protocol": "workspace:*",
    "@apps-in-toss/web-framework": "^2.10.7",
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.6.2",
    "jsdom": "^29.0.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "mini-app",
    "debug-console",
    "eruda",
    "on-device",
    "console"
  ],
  "packageManager": "pnpm@11.17.0",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toss/apps-in-toss-harness",
    "directory": "packages/debug-console"
  },
  "bugs": {
    "url": "https://github.com/toss/apps-in-toss-harness/issues"
  },
  "homepage": "https://github.com/toss/apps-in-toss-harness"
}
