{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // No DOM. The daemon is a Node process: it *authors* page-side source as
    // strings and ships them over CDP, but it never touches a DOM itself.
    // Omitting the lib turns that boundary into a compile error rather than a
    // convention. The suites that evaluate those strings under jsdom need DOM
    // globals, so they typecheck via `tsconfig.test.json` instead.
    "lib": ["ES2022"],
    "types": ["node"],
    // Relaxed relative to the workspace baseline, for this package only.
    //
    // This package is vendored wholesale from `@apps-in-toss/devtools`, which
    // compiled under plain `strict`. Both flags below are clean in
    // `debug-console` and `internal-protocol` and stay on there; turning them
    // on for the vendored half means ~110 rewrites at index and
    // optional-property sites — a behaviour-bearing change that has no business
    // riding along with a package split. Ratcheting them back on, directory by
    // directory, is follow-up work, not a permanent exemption.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "outDir": "dist",
    // Previously "src": when internal-protocol was a node_modules-resolved
    // sibling package, TS exempted it from the rootDir invariant (files
    // reached across a package boundary aren't counted). Now that the `paths`
    // alias below resolves it as a plain filesystem path inside THIS
    // program, TS enforces rootDir against it too (TS6059) — widen rootDir to
    // the actual common ancestor of src/ and shared/internal-protocol/src/.
    // `tsc` only runs here with `--noEmit` (see package.json's `typecheck`
    // script), so this never changes emitted output paths.
    "rootDir": "../..",
    // internal-protocol lives outside packages/ (shared/, not a pnpm workspace
    // member — #18 option 4), so there is no node_modules symlink to resolve
    // the bare `@apps-in-toss/internal-protocol/*` specifier through. Map it
    // straight onto the shared source directory; the bundler alias in
    // tsdown.config.ts and the test alias in vitest.config.ts must mirror this
    // exactly or the two toolchains disagree about where the specifier points.
    "paths": {
      "@apps-in-toss/internal-protocol/*": ["../../shared/internal-protocol/src/*.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts"]
}
